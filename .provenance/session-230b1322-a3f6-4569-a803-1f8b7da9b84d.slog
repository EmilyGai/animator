razor","version":"10.0.0"},{"enabled":false,"id":"vscode.references-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":false,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.44.0"}]},"hash":"c91d9c1fc5abac0332969a1a0a1cbc614670bcb2b1a38a1e8311dc1062f464a5","kind":"ext.snapshot","prev_hash":"1806864d09493a86975e44e9554557818502f40031863352fb6468bcdf996c66","seq":2,"t":2,"wall":"2026-11-21T00:59:16.908Z"}
