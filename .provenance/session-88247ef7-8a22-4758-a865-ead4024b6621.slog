.razor","version":"10.0.0"},{"enabled":false,"id":"vscode.references-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":false,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.44.0"}]},"hash":"87e34007fff216f4bd3c14a36810ffb9f4935d3a9534e7cbad5e01192a2da2ef","kind":"ext.snapshot","prev_hash":"bc4264fce8c58270fb7e9d2ae0e228766261048822d9c77e05aef938fb9d7baf","seq":2,"t":2,"wall":"2026-11-21T01:47:05.233Z"}
